GROQ_API_KEY=gsk_your_api_key_here
PORT=8000
ALLOWED_ORIGINS=https://valakyr159.github.io,http://localhost:4200
MAX_PDF_SIZE_MB=20
GEMINI_API_KEY=your_gemini_api_key_here
# Genshin meta store (Supabase, shared "PersonalWebsite" project). Optional: without all three, the meta is kept in
# memory and lost on every restart. Use the PUBLIC anon key, never the service_role key (see db/genshin_meta.sql).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
GENSHIN_DB_SECRET=a_long_random_secret_whose_sha256_is_registered_in_pw_app_access
